[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../target/debug/libgyra.so"
linux.release.x86_64 =   "res://../target/release/libgyra.so"
windows.debug.x86_64 =   "res://../target/debug/gyra.dll"
windows.release.x86_64 = "res://../target/release/gyra.dll"
macos.debug =            "res://../target/debug/libgyra.dylib"
macos.release =          "res://../target/release/libgyra.dylib"
macos.debug.arm64 =      "res://../target/debug/libgyra.dylib"
macos.release.arm64 =    "res://../target/release/libgyra.dylib"
